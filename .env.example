# Copy to .env and fill in. NEVER commit the real .env (it is git-ignored).
# start.sh / start.bat load this file automatically if it exists.

# Operator login (normal sign-in). Defaults to admin / admin123 with a warning banner until set.
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=

# "Formulas & Calculations" section — a SEPARATE password, never the login password.
# Verified server-side; unlocks the current session for FORMULA_UNLOCK_MINUTES (default 30).
# Alternative: FORMULA_SECTION_PASSWORD_HASH=<pbkdf2 string from backend.core.security.hash_password>
FORMULA_SECTION_PASSWORD=
FORMULA_UNLOCK_MINUTES=30

# NVIDIA OCR (hosted NIM): free key at https://build.nvidia.com ; or NVIDIA_OCR_URL for a local NIM container
NVIDIA_API_KEY=
# NVIDIA_OCR_URL=http://localhost:8010/v1/infer

# Email for patient verification codes (without SMTP_HOST the code is shown on screen in DEV MODE)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Server port used by start.sh / start.bat
PORT=8000